# Скопируйте в .env и впишите ключ. Файл .env в git не попадает (.gitignore).
ANTHROPIC_API_KEY=

# Необязательно — значения по умолчанию указаны справа.
# CARD_MODEL=claude-opus-5-5        # модель Claude
# CARD_EFFORT=medium                # глубина рассуждений: low | medium | high | xhigh | max
# CARD_VERIFY=1                     # второй проход: LLM-фактчекер (0 — выключить)
# CARD_MAX_REPAIRS=2                # сколько раз просить модель исправить замечания
# CARD_TIMEOUT=180                  # таймаут запроса к API, секунды
# CARD_REFUSAL_FALLBACK=1           # серверный откат на другую модель при отказе (beta)
# ANTHROPIC_BASE_URL=               # свой адрес API, например корпоративный прокси
